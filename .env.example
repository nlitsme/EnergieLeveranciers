# Environment variables for batterijberekening
# Copy to .env and fill in your credentials

# Energy Provider
ENERGY_PROVIDER=eneco  # or vattenfall

# Eneco credentials
ENECO_USERNAME=your_email@example.com
ENECO_PASSWORD=your_password
ENECO_API_KEY=41ff1058fc7f4446b80db84e8857c347

# Vattenfall credentials
VATTENFALL_AUTH_TOKEN=your_bearer_token
VATTENFALL_CUSTOMER_ID=your_customer_id
VATTENFALL_API_KEY=f5406a12dbdd41a2ad8e0de5a69d9e00

# Timezone
TIMEZONE=Europe/Amsterdam

# Data settings
YEARS_BACK=2
DATA_DIR=data
OUTPUT_DIR=output

# Logging
LOG_LEVEL=INFO
LOG_FILE=output/batterijberekening.log