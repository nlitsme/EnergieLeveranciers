# batterijberekening - Example Configuration
# Copy this to config.yaml and fill in your credentials
# Or use environment variables (recommended for secrets)

# Energy provider: "eneco" or "vattenfall"
energy_provider:
  provider: "eneco"
  
  # Eneco credentials (or set via ENECO_USERNAME/ENECO_PASSWORD env vars)
  eneco:
    username: ""  # your Eneco email
    password: ""  # your Eneco password
    api_key: "41ff1058fc7f4446b80db84e8857c347"  # FE_DC_API_KEY from Eneco website
    base_url: "https://api-digital.enecogroup.com"
    customer_id: ""  # Set after login
    account_id: ""   # Set after login
  
  # Vattenfall credentials (or set via VATTENFALL_AUTH_TOKEN/VATTENFALL_CUSTOMER_ID env vars)
  vattenfall:
    auth_token: ""  # Bearer token from browser dev tools (expires every 2h)
    customer_id: ""  # BusinessPartnerId/ContractAccountId (e.g., 0025431819)
    api_key: "ed989141b5c34d138dba4a3ce1dbe046"  # Ocp-Apim-Subscription-Key (from HAR)
    vf_context: ""  # vf-context header (e.g., "0025431819:003015847385")
    base_url: "https://api.vattenfall.nl/api/mvf/consumptions/v0"

# Timezone for all timestamps
timezone:
  zone: "Europe/Amsterdam"

# Data settings
data:
  years_back: 2
  data_dir: "data/raw"
  output_dir: "data/processed"
  plots_dir: "output/plots"
  exports_dir: "output/exports"

# Night consumption analysis settings
night_consumption:
  solar_threshold_pct: 0.01  # 1% of daily max solar = "night"
  min_hours_per_day: 24      # Require 24 valid hours per day

# Battery sizing and economics
battery:
  battery_cost_per_kwh: 600      # €/kWh installed
  energy_price_per_kwh: 0.30     # €/kWh grid price
  feedin_tariff_per_kwh: 0.08    # €/kWh feed-in tariff
  roundtrip_efficiency: 0.90     # 90%
  dod_limit: 0.90                # 90% depth of discharge
  
  # Percentiles for sizing
  min_capacity_percentile: 0.05      # P5
  recommended_capacity_percentile: 0.50  # P50 (median)
  max_capacity_percentile: 0.95      # P95

# Analysis settings
analysis:
  quantiles: [0.05, 0.25, 0.50, 0.75, 0.95]
  smoothing_window: 3  # months for rolling average

# Plotting settings
plotting:
  style: "whitegrid"
  palette: "viridis"
  figsize: [12, 8]
  dpi: 150
  title_size: 16
  label_size: 14
  tick_size: 12
  legend_size: 11
  median_color: "#2E86AB"
  iqr_color: "#A23B72"
  outer_color: "#F18F01"
  interactive:
    enabled: true
    output_format: "html"

# Logging settings
logging:
  level: "INFO"
  file: "logs/batterijberekening.log"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  max_bytes: 10485760  # 10MB
  backup_count: 5